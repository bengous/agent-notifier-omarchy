#!/usr/bin/env bash
# Every gate the CI runs, in the order it reports them.
set -euo pipefail

REPO_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

GATES=(
  scripts/check
  scripts/check-modules
  scripts/check-qml
  scripts/check-shell
  tests/qml/run.sh
)

for gate in "${GATES[@]}"; do
  echo "==> ${gate}"
  "${REPO_DIR}/${gate}"
done

echo "==> all gates passed"
